{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-diff",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-29",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/s/*"
    ]
  },
  "vars": {
    "APP_ORIGIN": "http://127.0.0.1:5173",
    "GITHUB_APP_SLUG": "",
    "GITHUB_CLIENT_ID": ""
  },
  "ratelimits": [
    {
      "name": "AUTH_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "API_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "SCAN_LIMITER",
      "namespace_id": "1005",
      "simple": {
        "limit": 600,
        "period": 60
      }
    },
    {
      "name": "FILE_LIMITER",
      "namespace_id": "1004",
      "simple": {
        "limit": 600,
        "period": 60
      }
    },
    {
      "name": "SHARE_LIMITER",
      "namespace_id": "1003",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": false
  },
  "kv_namespaces": [
    {
      "binding": "SHARE_RESULTS",
      "id": "00000000000000000000000000000000"
    }
  ]
}
