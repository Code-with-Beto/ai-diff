{
  "name": "ai-diff",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "deploy": "npm run build:deploy && wrangler deploy",
    "check:deploy": "npm run build:deploy && wrangler deploy --dry-run",
    "test:git": "node scripts/check-git.mjs",
    "build:deploy": "tsc -b && vite build --mode deployment"
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.0",
    "@cloudflare/workers-types": "^5.20260929.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^6.0.0",
    "vite": "^8.3.1",
    "vitest": "^4.1.0",
    "wrangler": "^4.0.0"
  },
  "overrides": {
    "undici": "^7.29.1"
  },
  "description": "Your code. Before and after AI. Compare lines added in your GitHub history.",
  "license": "MIT",
  "author": "Beto (https://codewithbeto.dev)",
  "homepage": "https://aidiff.cwb.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Code-with-Beto/ai-diff.git"
  },
  "bugs": {
    "url": "https://github.com/Code-with-Beto/ai-diff/issues"
  },
  "engines": {
    "node": ">=24"
  }
}
